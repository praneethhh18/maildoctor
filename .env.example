# Which brain: auto | gemini | openai | offline
MAILDOCTOR_LLM=auto

# Google Gemini (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI or any OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Agent guardrail: max tool-calling rounds per investigation
MAILDOCTOR_MAX_STEPS=12
# Seconds to wait for one AI reply / for the whole AI run (then falls back to rules)
MAILDOCTOR_LLM_TIMEOUT=90
MAILDOCTOR_AGENT_BUDGET=150

# DNS: auto (system, then DoH) | system | doh
MAILDOCTOR_DNS=auto
MAILDOCTOR_DNS_TIMEOUT=4
MAILDOCTOR_HTTP_TIMEOUT=8
